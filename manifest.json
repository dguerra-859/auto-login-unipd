{
  "manifest_version": 3,
  "name": "Auto Login Portale Studenti (Non Ufficiale)",
  "version": "3.10",
  "description": "Accesso SSO UniPD e dashboard locale con sincronizzazione automatica da STEM e Uniweb.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://shibidp.cca.unipd.it/*",
    "https://stem.elearning.unipd.it/*",
    "https://uniweb.unipd.it/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "Impostazioni Auto Login"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shibidp.cca.unipd.it/*",
        "https://stem.elearning.unipd.it/*",
        "https://uniweb.unipd.it/*"
      ],
      "css": [
        "styles/loading.css"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/logo.png"
      ],
      "matches": [
        "https://shibidp.cca.unipd.it/*",
        "https://stem.elearning.unipd.it/*",
        "https://uniweb.unipd.it/*"
      ]
    }
  ]
}