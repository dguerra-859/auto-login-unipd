{
  "manifest_version": 3,
  "name": "Auto Login Portale Studenti (Non Ufficiale)",
  "version": "2.4",
  "description": "Salta la schermata SSO di Moodle e compila automaticamente username, dominio e password.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Impostazioni Auto Login"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shibidp.cca.unipd.it/*",
        "https://stem.elearning.unipd.it/*",
        "https://uniweb.unipd.it/*"
      ],
      "css": [
        "loading.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png"
      ],
      "matches": [
        "https://shibidp.cca.unipd.it/*",
        "https://stem.elearning.unipd.it/*",
        "https://uniweb.unipd.it/*"
      ]
    }
  ]
}